<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 卡片背景图片（用于动态设置背景着色与透明度） -->
    <ImageView
        android:id="@+id/card_bg_image_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_rounded" />

    <!-- 列表内容卡片 -->
    <LinearLayout
        android:id="@+id/inner_content_card_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 头部信息栏 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tv_header_title_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"
                android:textSize="14dp"
                android:textStyle="bold"
                tools:text="第 8 周 周五" />

            <TextView
                android:id="@+id/tv_header_count_summary_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11dp"
                tools:text="今日还有 3 节课" />
        </RelativeLayout>

        <!-- 列表视图区域 -->
        <ListView
            android:id="@+id/list_view_courses_dark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:listitem="@layout/widget_item_course_list_node" />
    </LinearLayout>

    <!-- 局部无课/完成状态提示区域 -->
    <LinearLayout
        android:id="@+id/container_status_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_status_title_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13dp"
            tools:text="今日课程已结束" />
    </LinearLayout>

    <!-- 全局状态提示区域（如假期中） -->
    <FrameLayout
        android:id="@+id/container_full_status_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/full_status_bg_image_dark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg_rounded" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_full_status_title_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"
                android:textSize="16dp"
                android:textStyle="bold"
                tools:text="假期中" />

            <TextView
                android:id="@+id/tv_full_status_msg_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12dp"
                tools:text="期待新学期" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>